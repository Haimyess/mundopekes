# Snyk policy file
version: v1.25.0
exclude:
  global:
    - .claude/worktrees/**
    - apps/*/. output/**
    - '**/. output/**'
ignore:
  SNYK-JS-LEAFLET-16427276:
    - '*':
        reason: No patch available for leaflet XSS. Low real-world risk in SSR context where user input is sanitized server-side.
        expires: '2026-12-31T00:00:00.000Z'
  GHSA-xxjr-mmjv-4gpg:
    - '*':
        reason: lodash in commitizen devDependency only, never reaches production bundle.

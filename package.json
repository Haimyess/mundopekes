{
  "name": "mundopekes-monorepo",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "layers/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web -- --host",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build:web": "npm run build --workspace=apps/web",
    "build:admin": "npm run build --workspace=apps/admin",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:web": "npm run test --workspace=apps/web",
    "test:admin": "npm run test --workspace=apps/admin",
    "commit": "cz",
    "security:check": "snyk test --all-projects",
    "security:monitor": "snyk monitor --all-projects",
    "prepare": "node -e \"const{execSync}=require('child_process');if(process.env.CI!=='1')execSync('husky',{stdio:'inherit'})\""
  },
  "overrides": {
    "devalue": "5.8.1",
    "brace-expansion": "5.0.6",
    "ws": "8.20.1",
    "nitropack": "2.13.4"
  },
  "engines": {
    "node": "22.x"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@nuxt/eslint": "^1.15.2",
    "commitizen": "^4.2.4",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "snyk": "^1.1304.0"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "resend": "^6.12.3"
  }
}

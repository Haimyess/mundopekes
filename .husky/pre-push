echo "Running lint (full repo, same as CI)..."
npm run lint
if [ $? -ne 0 ]; then
  echo "Lint failed. Push blocked."
  exit 1
fi
echo "Lint passed"

echo "Running Snyk security check..."
npm run security:check
if [ $? -ne 0 ]; then
  echo "Snyk found vulnerabilities. Push blocked."
  exit 1
fi
echo "Snyk check passed"

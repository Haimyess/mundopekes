{
  "name": "mundopekes-monorepo",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.34.8",
  "scripts": {
    "preinstall": "node -e \"if(!/^pnpm\\//.test(process.env.npm_config_user_agent||'')){console.error('Use pnpm: corepack enable && pnpm install');process.exit(1)}\"",
    "dev:web": "pnpm --filter ./apps/web dev --host",
    "dev:admin": "pnpm --filter ./apps/admin dev",
    "build:web": "pnpm --filter ./apps/web build",
    "build:admin": "pnpm --filter ./apps/admin build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:web": "pnpm --filter ./apps/web test",
    "test:admin": "pnpm --filter ./apps/admin test",
    "test:packages": "pnpm --filter \"./packages/**\" test",
    "commit": "cz",
    "security:check": "snyk test --all-projects --policy-path=.snyk",
    "security:monitor": "snyk monitor --all-projects",
    "prepare": "node -e \"const{execSync}=require('child_process');if(process.env.CI!=='1')execSync('husky',{stdio:'inherit'})\""
  },
  "engines": {
    "node": "22.x"
  },
  "lint-staged": {
    "*.{ts,vue,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@mundopekes/config": "workspace:*",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/eslint-config": "^1.17.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "commitizen": "^4.2.4",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "snyk": "^1.1304.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@nuxt/image": "^2.0.0",
    "@vercel/analytics": "^2.0.1",
    "h3": "1.15.11",
    "resend": "^6.12.3"
  }
}
